/* MinimalDialog styles */
MinimalDialog {
    align: center middle;
}

#dialog {
    width: 60%;
    min-width: 40;
    max-width: 80;
    height: 13;
    background: $surface;
    border: solid $primary;
    grid-rows: auto auto;
    grid-gaps: 1;
    padding: 1;
}

#title {
    text-align: center;
    text-style: bold;
    color: $text;
}

#input {
    width: 100%;
}

/* DeleteBranchDialog styles */
DeleteBranchDialog {
    align: center middle;
}

DeleteBranchDialog #dialog {
    width: 50;
    height: 8;
    background: $surface;
    border: solid $error;
    grid-rows: auto auto auto;
    grid-gaps: 1;
    padding: 1;
}

DeleteBranchDialog #message {
    text-align: center;
    color: $text;
}

DeleteBranchDialog #button-container {
    width: 100%;
    grid-columns: 1fr 1fr;
    grid-gaps: 1;
}

/* ConfirmDialog styles */
ConfirmDialog {
    align: center middle;
}

ConfirmDialog #dialog {
    width: 50;
    height: 8;
    background: $surface;
    border: solid $primary;
    grid-rows: auto auto auto;
    grid-gaps: 1;
    padding: 1;
}

ConfirmDialog #message {
    text-align: center;
    color: $text;
}

ConfirmDialog #button-container {
    width: 100%;
    grid-columns: 1fr 1fr;
    grid-gaps: 1;
}

